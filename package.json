{
    "name": "react-pdf-resume",
    "type": "module",
    "private": true,
    "scripts": {
        "lint": "eslint . --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "format": "prettier --config prettier.config.js --write .",
        "check-types": "tsc --noEmit",
        "dev": "vite dev",
        "render": "vite-node src/index.print.tsx",
        "prepare": "husky"
    },
    "dependencies": {
        "@react-pdf/renderer": "^4.3.2",
        "react": "^19.2.3",
        "react-dom": "^19.2.3"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.20.8",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@prettier/plugin-oxc": "^0.2.3",
        "@types/node": "^26.6.3",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "prettier": "^3.7.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vite-node": "^6.0.0"
    },
    "packageManager": "pnpm@12.8.1"
}
